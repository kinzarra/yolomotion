# Copy to .env in the repo root and fill in. Never commit the filled file.

# ElevenLabs — TTS in the house voice: npm run voiceover
# The voice id itself is pinned in each scripts/voiceover/<id>.json manifest.
ELEVENLABS_API_KEY=

# HeyGen — talking-head inserts: npm run heygen (always --dry-run first, it bills per second)
HEYGEN_API_KEY=
# Avatar group / Digital Twin used by default.
HEYGEN_AVATAR_ID=
# Photo-avatar look for the podcast-studio shot; a manifest asks for it by name
# as "avatarId": "${HEYGEN_AVATAR_VIEW_ID}".
HEYGEN_AVATAR_VIEW_ID=
