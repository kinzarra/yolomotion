# Normalise line endings so a Windows/Linux checkout matches macOS.
* text=auto eol=lf

# Never diff or merge these as text.
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.wav binary
*.aiff binary

# Generated — collapse in review, but keep them in the repo.
package-lock.json linguist-generated=true -diff
packages/video/src/templates/*/durations.ts linguist-generated=true
packages/video/src/templates/*/presenter.ts linguist-generated=true
